STA VIOLATION
###fix max_transition
##get report#s
extractRC
timeDesign -postRoute
report_constraint -drv_violation_type max_transition -all_violators > max_tran_viols.rpt
set target_pin " "
set target_net [dbGet [dbGet -p top.insts.instTerms.name $target_pin].net.name]
puts $target_net
#RC report
report_net -net $target_net
#Physical report
deselectAll
selectNet $target_net
##choose site to put buffer
ecoAddRepeater -net "net selected" -cell CLKBUFX16 -loc { }
ecoChangeCell -inst "sell selected" -cell NOR2X4 
ecoPlace
ecoRoute
#check INST from lib
get_object_name [get_lib_cells *AOI221*]
#check the relation of connection
dbGet [dbGet -p top.insts.instTerms.name "proc0/rf0/u0/u1/PRECTS_FE_OFC4372_n_2798/A"].net.allTerms.name
##when change SDC
set_interactive_constraint_modes [all_constraint_modes -active]
"write your order"
set_interactive_constraint_modes {}


DRC VIOLATION
###Antenna
##check violations
verifyProcessAntenna
less xxx.rpt(linux)
##solution
set target_pin " "
set target_net [dbGet [dbGet -p top.insts.instTerms.name $target_pin].net.name]
setNanoRouteMode -drouteFixAntenna true
setNanoRouteMode -routeInsertAntennaDiode  false
deselectAll
selectNet $target_net
setNanoRouteMode -routeSelectedNetOnly true
ecoRoute -fix_drc
setNanoRouteMode -routeSelectedNetOnly false
deselectAll

